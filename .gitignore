# ============================================
# MoAI-ADK Package Distribution .gitignore
# ============================================
# Version: 0.33.0
# Updated: 2026-01-10
# Purpose: Essential patterns for user projects
# ============================================

# ===========================================
# Go Build Artifacts
# ===========================================
bin/
/xflow
/xflowd
/xflow-agent
*.exe
*.exe~
*.dll
*.so
*.dylib
cover.out
cover.html
coverage.out
coverage_*.out
*.test
cpu.prof
mem.prof

# ===========================================
# Runtime Data (xflowd)
# ===========================================
# xflowd 가 시작 시 생성하는 런타임 디렉토리.
# 데이터베이스, 로그, 디바이스 메타 등이 포함됨 → 버전 관리 대상이 아님.
/data/

# ===========================================
# Frontend Build Artifacts (tsc -b 산출물)
# ===========================================
# vite.config.ts 컴파일 시 생성되는 .d.ts/.js 사이드카.
# 소스는 vite.config.ts 만 추적한다.
web/vite.config.d.ts
web/vite.config.js

# ===========================================
# Build Artifacts & Distribution
# ===========================================
build/
dist/
*.egg-info/
*.egg

