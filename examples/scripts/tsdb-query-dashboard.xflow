# tsdb-query-dashboard.xflow
# TSDB 대시보드 쿼리 플로우 배포 스크립트
#
# TSDB에 저장된 센서 데이터를 주기적으로 조회하여 대시보드용 메트릭을 생성한다.
# HTTP 요청으로 트리거되면 다운샘플링 쿼리와 Raw 쿼리를 병렬로 실행한다.
#
# 주의: tsdb-sensor-logging 플로우가 먼저 실행되어 데이터가 수집되어 있어야 한다.
#
# 사용법:
#   xflow script -f examples/scripts/tsdb-query-dashboard.xflow
#   xflow script -f examples/scripts/tsdb-query-dashboard.xflow --dry-run
#   xflow script -f examples/scripts/tsdb-query-dashboard.xflow --verbose

# 1. TSDB 엔진 에이전트 등록 (인메모리 시계열 DB)
agent import -f examples/agents/tsdb-engine.yaml --skip-existing

# 2. 콘솔 로거 에이전트 등록 (쿼리 결과 출력용)
agent import -f examples/agents/stdout-logger.yaml --skip-existing

# 3. 에러 로거 에이전트 등록 (에러 출력용)
agent import -f examples/agents/error-logger.yaml --skip-existing

# 4. 에이전트 등록 확인
agent list

# 5. 대시보드 쿼리 플로우 가져오기
flow import -f examples/flows/tsdb-query-dashboard.yaml --skip-existing

# 6. 플로우 배포 및 시작
flow deploy tsdb-query-dashboard
flow start tsdb-query-dashboard

# 7. 상태 확인
flow status tsdb-query-dashboard

# 8. HTTP 트리거로 쿼리 실행 (수동 테스트)
# curl http://localhost:8080/api/v1/flows/tsdb-query-dashboard/trigger
