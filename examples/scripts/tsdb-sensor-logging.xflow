# tsdb-sensor-logging.xflow
# MQTT 센서 데이터 → TSDB 기록 플로우 배포 스크립트
#
# MQTT 브로커에서 센서 데이터를 수신하여 필드를 추출하고,
# TSDB에 시계열로 기록한 뒤 콘솔에 출력하는 파이프라인을 배포한다.
#
# 사용법:
#   xflow script -f examples/scripts/tsdb-sensor-logging.xflow
#   xflow script -f examples/scripts/tsdb-sensor-logging.xflow --dry-run
#   xflow script -f examples/scripts/tsdb-sensor-logging.xflow --verbose

# 1. TSDB 엔진 에이전트 등록 (인메모리 시계열 DB)
agent import -f examples/agents/tsdb-engine.yaml --skip-existing

# 2. MQTT 센서 에이전트 등록 (센서 데이터 입력)
agent import -f examples/agents/mqtt-sensor.yaml --skip-existing

# 3. 콘솔 로거 에이전트 등록 (데이터 출력용)
agent import -f examples/agents/stdout-logger.yaml --skip-existing

# 4. 에러 로거 에이전트 등록 (에러 출력용)
agent import -f examples/agents/error-logger.yaml --skip-existing

# 5. 에이전트 등록 확인
agent list

# 6. 센서 로깅 플로우 가져오기
flow import -f examples/flows/tsdb-sensor-logging.yaml --skip-existing

# 7. 플로우 배포 및 시작
flow deploy tsdb-sensor-logging
flow start tsdb-sensor-logging

# 8. 상태 확인
flow status tsdb-sensor-logging
